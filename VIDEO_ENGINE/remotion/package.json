{
  "name": "remotion-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "tsc": "tsc --noEmit",
    "gallery": "tsx scripts/gen_gallery.ts && remotion render src/index.ts Main ../out/gallery.mp4 --props=./public/gallery.json --scale=0.5 --every-nth-frame=2",
    "render:test": "remotion render src/index.ts Main ../out/test.mp4 --props=./public/composition.json --scale=0.5 --every-nth-frame=2 --concurrency=3",
    "render:final": "remotion render src/index.ts Main ../out/final.mp4 --props=./public/composition.json --concurrency=3"
  },
