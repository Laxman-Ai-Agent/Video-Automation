# ==============================================================================
# LAXMAN-AUTONOMOUS MASTER SYSTEM: Production Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit or distribute the .env file containing real API keys or secrets.
# ==============================================================================

# --- Server & UI Port Configuration ---
PORT=8000
UI_PORT=5173
HOST=127.0.0.1

# --- Speech-to-Text (Whisper Local Inference) ---
# Options: tiny, base, small, medium, large-v3
# Models are loaded from local Hugging Face cache. "medium" is recommended for CPU inference.
WHISPER_MODEL=medium

# --- Large Language Model (LLM) Gateway ---
# Provider selection: auto, gemini, anthropic, openai, groq, deepseek, claude_cli
LLM_PROVIDER=auto
LLM_MODEL=

# Set the API key for your chosen provider (leave unused keys blank):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Optional custom OpenAI-compatible endpoint:
LLM_BASE_URL=

# --- Stock Media Provider APIs (Optional) ---
# Required only if searching and downloading live stock photos during visual planning.
# If blank, pipeline operates in synthetic/kinetic motion-only mode.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Video Engine & Motion Architecture Flags ---
# 1 = Enable Remotion kinetic typography and layout engine (Default: 1)
A2V_MOTION=1
# 1 = Enable strict cryptographic fingerprint tracking across pipeline stages
A2V_FINGERPRINTS=1
# Motion pacing factor (1.0 = default pace, 1.3 = fast pace)
A2V_MOTION_SPEED=1.3

# --- Headless Browser Executable Override (Optional) ---
# Auto-detected from standard host Chrome paths if omitted.
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
